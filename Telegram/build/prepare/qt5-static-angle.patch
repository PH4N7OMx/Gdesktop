diff --git a/mkspecs/features/win32/opengl.prf b/mkspecs/features/win32/opengl.prf
--- a/mkspecs/features/win32/opengl.prf
+++ b/mkspecs/features/win32/opengl.prf
@@ -13,10 +13,19 @@
 qtConfig(opengles2) {
     # Depending on the configuration we use libQtANGLE or libEGL and libGLESv2
-    qtConfig(combined-angle-lib) {
-        prependOpenGlLib($$LIBQTANGLE_NAME)
+    qtConfig(angle) {
+        qtConfig(combined-angle-lib) {
+            prependOpenGlLib($$LIBQTANGLE_NAME)
+        } else {
+            prependOpenGlLib($$LIBGLESV2_NAME)
+            prependOpenGlLib($$LIBEGL_NAME)
+        }
     } else {
-        prependOpenGlLib($$LIBGLESV2_NAME)
-        prependOpenGlLib($$LIBEGL_NAME)
+        # External static ANGLE has separate Debug and Release libraries.
+        CONFIG(debug, debug|release) {
+            !isEmpty(QMAKE_LIBS_OPENGL_ES2_DEBUG): QMAKE_LIBS_OPENGL_ES2 = $$QMAKE_LIBS_OPENGL_ES2_DEBUG
+        } else {
+            !isEmpty(QMAKE_LIBS_OPENGL_ES2_RELEASE): QMAKE_LIBS_OPENGL_ES2 = $$QMAKE_LIBS_OPENGL_ES2_RELEASE
+        }
     }
 #   For Desktop, use the ANGLE library location passed on from configure.
     INCLUDEPATH += $$QMAKE_INCDIR_OPENGL_ES2
diff --git a/mkspecs/features/egl.prf b/mkspecs/features/egl.prf
--- a/mkspecs/features/egl.prf
+++ b/mkspecs/features/egl.prf
@@ -1,3 +1,12 @@
+# External static ANGLE on Windows supplies per-configuration libraries.
+win32:!qtConfig(angle) {
+    CONFIG(debug, debug|release) {
+        !isEmpty(QMAKE_LIBS_EGL_DEBUG): QMAKE_LIBS_EGL = $$QMAKE_LIBS_EGL_DEBUG
+    } else {
+        !isEmpty(QMAKE_LIBS_EGL_RELEASE): QMAKE_LIBS_EGL = $$QMAKE_LIBS_EGL_RELEASE
+    }
+}
+
 INCLUDEPATH += $$QMAKE_INCDIR_EGL
 LIBS_PRIVATE += $$QMAKE_LIBS_EGL
 QMAKE_CFLAGS += $$QMAKE_CFLAGS_EGL
