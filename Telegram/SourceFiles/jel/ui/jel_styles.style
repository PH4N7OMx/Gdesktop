using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

iconPickerSelectedPadding: 2px;
iconPickerSelectedRounding: 12px;
iconPickerImagePadding: 4px;
iconPickerIconSize: 80px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "jel/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "jel/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "jel/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "jel/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

exteraBadgeToast: Toast(defaultToast) {
	minWidth: 40px;
	maxWidth: 480px;
	padding: margins(54px, 13px, 19px, 12px);
}

exteraBadgeToastBadge: InfoPeerBadge(infoPeerBadge) {
	premiumFg: toastFg;
}

supportLogoSize: 96px;

unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

pluginShowInFolderIcon: icon {{ "menu/show_in_folder", boxTitleCloseFg }};
pluginShowInFolderIconOver: icon {{ "menu/show_in_folder", boxTitleCloseFgOver }};
pluginShowInFolder: IconButton(defaultIconButton) {
	width: boxTitleHeight;
	height: boxTitleHeight;

	icon: pluginShowInFolderIcon;
	iconOver: pluginShowInFolderIconOver;

	rippleAreaPosition: point(4px, 4px);
	rippleAreaSize: 40px;
	ripple: defaultRippleAnimationBgOver;
}
maxPluginDescriptionHeight: 400px;
pluginVersionAuthorLabel: FlatLabel(boxLabel) {
	   align: align(center);
}
pluginChipSkip: 6px;

ghostPickerArrow: icon{{ "info/edit/expand_arrow_small", windowActiveTextFg }};

ghostPickerButton: LinkButton(defaultLinkButton) {
	color: windowActiveTextFg;
	overColor: windowActiveTextFg;
	font: font(boxFontSize);
	overFont: font(boxFontSize);
}

jelBetaBadgePadding: margins(4px, 1px, 4px, 1px);

jelServiceTimeBadgeFont: font(11px semibold);
jelServiceTimeBadgeHorizontalPadding: 7px;
jelServiceTimeBadgeVerticalPadding: 2px;
jelServiceTimeBadgeGap: 8px;
jelServiceTimeBadgeTrailingInset: 3px;
jelServiceTimeBadgeLastLineWidthAdd: 9px;

using "dialogs/dialogs.style";
using "chat_helpers/chat_helpers.style";
using "ui/menu_icons.style";

macosDialogRow: DialogRow(defaultDialogRow) {
	height: 70px;
	padding: margins(10px, 10px, 10px, 10px);
	photoSize: 50px;
	nameLeft: 70px;
	nameTop: 9px;
	textLeft: 70px;
	textTop: 27px;
}
macosTaggedDialogRow: DialogRow(taggedDialogRow, macosDialogRow) {
	height: 80px;
	textTop: 32px;
	tagTop: 60px;
}
macosForumDialogRow: DialogRow(forumDialogRow, macosDialogRow) {
	height: 88px;
	textTop: 34px;
}
macosTaggedForumDialogRow: DialogRow(taggedForumDialogRow, macosForumDialogRow) {
	height: 104px;
	tagTop: 85px;
}
macosDialogsFont: font(13px);
macosDialogsUnreadFont: font(11px semibold);
macosDialogsTextStyle: TextStyle(defaultTextStyle) {
	font: macosDialogsFont;
	lineHeight: 16px;
}
macosDialogsDateFont: font(12px);
macosDialogsFilter: InputField(dialogsFilter) {
	borderRadius: 10px;
	border: 0px;
	borderActive: 0px;
	textMargins: margins(12px, 7px, 30px, 6px);
}
macosMessagePadding: margins(10px, 7px, 10px, 7px);
macosSettingsButton: SettingsButton(settingsButton) {
	padding: margins(48px, 10px, 14px, 10px);
	height: 20px;
	iconLeft: 14px;
	toggleSkip: 14px;
	style: TextStyle(defaultTextStyle) { font: font(14px); }
	rightLabel: FlatLabel(defaultSettingsRightLabel) {
		style: TextStyle(defaultTextStyle) { font: font(13px); }
	}
}
macosSettingsButtonNoIcon: SettingsButton(settingsButtonNoIcon, macosSettingsButton) {
	padding: margins(14px, 10px, 14px, 10px);
}

