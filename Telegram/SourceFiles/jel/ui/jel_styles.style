	objects: icon {{ "jel/macos/emojiobjects", emojiIconFg }};
	objectsActive: icon {{ "jel/macos/emojiobjects", emojiSubIconFgActive }};
	symbols: icon {{ "jel/macos/emojisymbols", emojiIconFg }};
	symbolsActive: icon {{ "jel/macos/emojisymbols", emojiSubIconFgActive }};
	menuFave: macosMenuIconFave;
	menuUnfave: macosMenuIconUnfave;
