	menuSetAdd: macosMenuIconAdd;
	menuSetShare: macosMenuIconShare;
	menuSetCopyLink: macosMenuIconLink;
	menuSetRemove: macosMenuIconDelete;
	menuEmojiStatus: macosMenuIconEmoji;
	menuEmojiCopy: macosMenuIconCopy;
