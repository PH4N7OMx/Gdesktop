	stripExpandDropdown: defaultComposeIcons.stripExpandDropdown;
	recent: icon {{ "jel/macos/emojirecent", emojiIconFg }};
	recentActive: icon {{ "jel/macos/emojirecent", emojiSubIconFgActive }};
	people: icon {{ "jel/macos/emojipeople", emojiIconFg }};
	peopleActive: icon {{ "jel/macos/emojipeople", emojiSubIconFgActive }};
	nature: icon {{ "jel/macos/emojinature", emojiIconFg }};
	natureActive: icon {{ "jel/macos/emojinature", emojiSubIconFgActive }};
	food: icon {{ "jel/macos/emojifood", emojiIconFg }};
	foodActive: icon {{ "jel/macos/emojifood", emojiSubIconFgActive }};
