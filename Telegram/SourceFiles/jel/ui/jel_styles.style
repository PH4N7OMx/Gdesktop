// Community rows keep their extra inset while sharing the native row metrics.
macosCommunityInfoDialogRow: DialogRow(communityInfoDialogRow, macosDialogRow) {
	padding: margins(22px, 10px, 18px, 10px);
	nameLeft: 84px;
	textLeft: 84px;
}
macosCommunityInfoTaggedDialogRow: DialogRow(communityInfoTaggedDialogRow, macosTaggedDialogRow) {
	padding: margins(22px, 10px, 18px, 10px);
	nameLeft: 84px;
	textLeft: 84px;
}
macosCommunityInfoForumDialogRow: DialogRow(communityInfoForumDialogRow, macosForumDialogRow) {
	padding: margins(22px, 10px, 18px, 10px);
	nameLeft: 84px;
	textLeft: 84px;
}
macosCommunityInfoTaggedForumDialogRow: DialogRow(communityInfoTaggedForumDialogRow, macosTaggedForumDialogRow) {
	padding: margins(22px, 10px, 18px, 10px);
	nameLeft: 84px;
	textLeft: 84px;
}
macosCommunityRequestableListItem: PeerListItem(communityRequestableListItem) {
	height: 70px;
	photoSize: 50px;
	photoPosition: point(10px, 10px);
	namePosition: point(72px, 12px);
	statusPosition: point(72px, 36px);
}
macosCommunityInfoRequestableListItem: PeerListItem(macosCommunityRequestableListItem) {
	photoPosition: point(22px, 10px);
	namePosition: point(84px, 12px);
	statusPosition: point(84px, 36px);
}

// AppMenuRowItem uses 13px text, 28px rows and an 18px outer corner.
macosMenuTextStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}
macosMenu: Menu(defaultMenu) {
	itemRadius: 14px;
	itemInset: 4px;
	frosted: true;
	itemPadding: margins(15px, 5px, 15px, 5px);
	itemStyle: macosMenuTextStyle;
	separator: MenuSeparator(defaultMenuSeparator) {
		padding: margins(11px, 2px, 11px, 2px);
	}
}
macosMenuWithIcons: Menu(menuWithIcons, macosMenu) {
	itemIconPosition: point(12px, 2px);
	itemPadding: margins(43px, 5px, 15px, 5px);
}
macosPopupMenu: PopupMenu(defaultPopupMenu) {
	radius: 18px;
	showDuration: 280;
	animation: PanelAnimation(defaultPanelAnimation) {
		startWidth: 0.85;
		startHeight: 0.85;
		startOpacity: 0.;
	}
	menu: macosMenu;
}
macosPopupMenuWithIcons: PopupMenu(popupMenuWithIcons, macosPopupMenu) {
	menu: macosMenuWithIcons;
}

macosWindowTitle: WindowTitle(defaultWindowTitle) {
	minimizeIconActive: defaultWindowTitle.minimizeIconActive;
	minimizeIconActiveOver: defaultWindowTitle.minimizeIconActiveOver;
	maximizeIconActive: defaultWindowTitle.maximizeIconActive;
	maximizeIconActiveOver: defaultWindowTitle.maximizeIconActiveOver;
	restoreIcon: defaultWindowTitle.restoreIcon;
	restoreIconOver: defaultWindowTitle.restoreIconOver;
	restoreIconActive: defaultWindowTitle.restoreIconActive;
	restoreIconActiveOver: defaultWindowTitle.restoreIconActiveOver;
	closeIconActive: defaultWindowTitle.closeIconActive;
	closeIconActiveOver: defaultWindowTitle.closeIconActiveOver;
	height: 32px;
	bg: dialogsBg;
	bgActive: dialogsBg;
	shadow: false;
	oneSideControls: true;
}

macosTopBarHeight: 50px;
macosBubbleRadiusSmall: 8px;

macosComposeField: InputField(historyComposeField) {
	textMargins: margins(14px, 8px, 14px, 8px);
	textBg: filterInputInactiveBg;
	textBgActive: filterInputInactiveBg;
	borderRadius: 20px;
	heightMin: 36px;
	placeholderMargins: margins(14px, 8px, 14px, 8px);
}

macosSettingsPhoto: UserpicButton(defaultUserpicButton) {
	size: size(60px, 60px);
	photoSize: 60px;
}
macosSettingsName: FlatLabel(defaultFlatLabel) {
	maxHeight: 20px;
	textFg: windowBoldFg;
	style: TextStyle(defaultTextStyle) { font: font(14px semibold); }
}

macosUnifiedWindowTitle: WindowTitle(macosWindowTitle) {
	controlsOverlayWidth: 70px;
	height: 50px;
}
macosDialogsSearchHeight: 40px;

macosDialogsSent: ThreeStateIcon {
	icon: icon {{ "jel/macos/readmarkone", dialogsSentIconFg, point(10px, 2px) }};
	over: icon {{ "jel/macos/readmarkone", dialogsSentIconFgOver, point(10px, 2px) }};
	active: icon {{ "jel/macos/readmarkone", dialogsSentIconFgActive, point(10px, 2px) }};
}
macosDialogsReceived: ThreeStateIcon {
	icon: icon { { "jel/macos/readmarkone", dialogsSentIconFg, point(6px, 2px) }, { "jel/macos/readmarktwo", dialogsSentIconFg, point(10px, 2px) } };
	over: icon { { "jel/macos/readmarkone", dialogsSentIconFgOver, point(6px, 2px) }, { "jel/macos/readmarktwo", dialogsSentIconFgOver, point(10px, 2px) } };
	active: icon { { "jel/macos/readmarkone", dialogsSentIconFgActive, point(6px, 2px) }, { "jel/macos/readmarktwo", dialogsSentIconFgActive, point(10px, 2px) } };
}
macosDialogsPinned: ThreeStateIcon {
	icon: icon {{ "jel/macos/listpinned", menuIconFg }};
	over: icon {{ "jel/macos/listpinned", menuIconFgOver }};
	active: icon {{ "jel/macos/listpinned", dialogsTextFgActive }};
}
macosDialogsMuted: ThreeStateIcon {
	icon: icon {{ "jel/macos/listmuted", menuIconFg }};
	over: icon {{ "jel/macos/listmuted", menuIconFgOver }};
	active: icon {{ "jel/macos/listmuted", dialogsTextFgActive }};
}
macosHistorySending: icon {{ "jel/macos/listsending", historySendingOutIconFg, point(5px, 4px) }};
macosHistorySendingInverted: icon {{ "jel/macos/listsending", historySendingInvertedIconFg, point(5px, 4px) }};
macosHistorySent: icon {{ "jel/macos/readmarkone", historyOutIconFg, point(2px, 3px) }};
macosHistoryReceived: icon { { "jel/macos/readmarkone", historyOutIconFg, point(2px, 3px) }, { "jel/macos/readmarktwo", historyOutIconFg, point(6px, 3px) } };
macosHistorySentSelected: icon {{ "jel/macos/readmarkone", historyOutIconFgSelected, point(2px, 3px) }};
macosHistoryReceivedSelected: icon { { "jel/macos/readmarkone", historyOutIconFgSelected, point(2px, 3px) }, { "jel/macos/readmarktwo", historyOutIconFgSelected, point(6px, 3px) } };

macosComposeIcon: icon {{ "jel/macos/compose", windowActiveTextFg }};

