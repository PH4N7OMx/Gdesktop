using "boxes/boxes.style";

macosPeerStatusStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}
macosPeerItem: PeerListItem(peerListBoxItem) {
	height: 50px;
	photoSize: 36px;
	photoPosition: point(10px, 7px);
	namePosition: point(56px, 8px);
	statusPosition: point(56px, 26px);
	nameStyle: TextStyle(defaultTextStyle) { font: font(14px semibold); }
	checkbox: RoundImageCheckbox(defaultPeerListCheckbox) {
		imageRadius: 18px;
		imageSmallRadius: 16px;
		check: RoundCheckbox(defaultPeerListCheck) { size: 0px; }
	}
}
macosContacts: PeerList(contactsWithStories) {
	item: macosPeerItem;
	padding: margins(0px, 0px, 0px, 0px);
}
macosRecentCalls: PeerList(macosContacts) {
	item: PeerListItem(macosPeerItem) {
		height: 46px;
		photoPosition: point(10px, 5px);
		namePosition: point(56px, 6px);
		statusPosition: point(56px, 24px);
	}
}

using "intro/intro.style";
macosAuthNextButton: RoundButton(introNextButton) {
	width: 280px;
	height: 36px;
	radius: 18px;
	fullRadius: true;
	textTop: 8px;
	style: TextStyle(defaultTextStyle) { font: font(15px semibold); }
}
macosAuthTitle: TextStyle(defaultTextStyle) {
	font: font(22px semibold);
}
macosAuthInfo: TextStyle(defaultTextStyle) {
	font: font(13px);
	lineHeight: 20px;
}

macosModalButton: RoundButton(defaultBoxButton) {
	height: 40px;
	radius: 20px;
	fullRadius: true;
	textTop: 12px;
	style: TextStyle(defaultTextStyle) { font: font(13px semibold); }
}
macosModalTitle: TextStyle(defaultTextStyle) {
	font: font(14px semibold);
}

macosAuthQrTitle: TextStyle(defaultTextStyle) { font: font(18px semibold); }
macosAuthInput: InputField(introCountry) {
	width: 280px;
	heightMin: 40px;
	borderRadius: 10px;
	border: 1px;
	borderActive: 1px;
	textMargins: margins(10px, 11px, 10px, 9px);
	placeholderScale: 0.;
	placeholderShift: 0px;
	placeholderFont: font(14px);
	style: TextStyle(defaultTextStyle) { font: font(14px); }
}
macosAuthCountry: InputField(macosAuthInput) {
	style: TextStyle(defaultTextStyle) { font: font(15px); }
	borderRadius: 0px;
	border: 0px;
	borderActive: 0px;
	textBg: transparent;
	textBgActive: transparent;
	textMargins: margins(10px, 11px, 30px, 9px);
}
macosAuthCountryCode: InputField(macosAuthCountry) {
	width: 64px;
	textMargins: margins(10px, 11px, 0px, 9px);
}
macosAuthPhone: InputField(macosAuthCountry) {
	width: 216px;
	textMargins: margins(0px, 11px, 10px, 9px);
}
macosAuthPhoneRadius: 10px;
macosAuthPhoneSeparatorInset: 10px;
macosAuthPhoneNextTop: 216px;
macosAuthPhoneErrorTop: 186px;
macosAuthPhoneQrTop: 272px;

macosAuthQrPixels: 186px;
macosAuthGap: 20px;
macosAuthGapCompact: 8px;
macosAuthPagePadding: 16px;

macosProfileTabsStrip: ProfileTabsStrip(infoProfileTabsStrip) {
	height: 52px;
	margin: margins(8px, 6px, 8px, 6px);
	activeSkip: 3px;
	tabPadding: margins(16px, 0px, 16px, 0px);
	style: TextStyle(defaultTextStyle) { font: font(14px semibold); }
	fg: windowFg;
	fgActive: windowFg;
	bgActive: macosTabsSelectionBg;
}

macosAuthQrStep: FlatLabel(introQrStep) {
	style: TextStyle(defaultTextStyle) { font: font(13px); }
	maxHeight: 32px;
}
macosAuthQrBadge: 20px;
macosAuthQrTextLeft: 30px;
macosAuthQrTextTop: 2px;
macosAuthQrRowBottom: 16px;
macosAuthQrLastBottom: 6px;

macosSettingsSliderSize: size(20px, 20px);

macosCheckMark: icon {{ "jel/macos/checkmark", overviewCheckFgActive }};
macosCheck: Check(defaultCheck) {
	diameter: 14px;
}
macosCheckboxStyle: TextStyle(defaultTextStyle) { font: font(13px); }

using "wallet/wallet.style";
using "ui/effects/credits.style";
macosSegmentedSlider: SettingsSlider(defaultTabsSlider) {
	height: 40px;
	padding: 0px;
	strictSkip: 24px;
	barSkip: -8px;
	barSnapToLabel: false;
	pill: true;
	pillInset: 3px;
	pillBg: windowBg;
	pillActiveBg: macosTabsSelectionBg;
	labelTop: 12px;
	labelStyle: TextStyle(defaultTextStyle) { font: font(14px semibold); }
	labelFg: windowFg;
	labelFgActive: windowFg;
	ripple: emptyRippleAnimation;
}

macosWindowMinHeight: 550px;

