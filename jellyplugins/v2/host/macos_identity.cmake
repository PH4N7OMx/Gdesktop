function(jelly_macos_identity target identifier)
    if (NOT APPLE)
        return()
    endif()
    set(jelly_identifier "${identifier}")
    set(jelly_name "${target}")
    set(plist "${CMAKE_CURRENT_BINARY_DIR}/${target}.Info.plist")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/host.Info.plist.in" "${plist}" @ONLY)
    target_link_options(${target} PRIVATE "LINKER:-sectcreate,__TEXT,__info_plist,${plist}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${plist}")
endfunction()
